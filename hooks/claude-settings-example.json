{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-session-start-bootstrap.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "saltmdb",
            "tool": "capture_trace_start",
            "input": {
              "harness": "claude_code",
              "harness_session_id": "${session_id}",
              "harness_turn_id": "${prompt_id}",
              "user_prompt": "${prompt}"
            },
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-pre-tool-search-gate.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__saltmdb__store_memory|mcp__saltmdb__search_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-post-tool-response-nudges.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__saltmdb__log_event",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-post-tool-failure-circuit-breaker.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__saltmdb__store_memory|mcp__saltmdb__revise_memory|mcp__saltmdb__supersede_memory|mcp__saltmdb__consolidate_memories",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "saltmdb",
            "tool": "capture_trace_memory_link",
            "input": {
              "harness_turn_id": "${prompt_id}"
            },
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "agent",
            "prompt": "You are the SALTMDB pre-compaction sweep hook. The current session's conversation transcript is about to be compacted and working context will be lost. Review the conversation so far for: unresolved decisions, root-cause fixes to bugs/issues, new architectural rules, or user preferences established in this session but NOT yet persisted to SALTMDB. For each item found, first call mcp__saltmdb__search_memory to confirm it isn't already recorded, and if genuinely new, call mcp__saltmdb__store_memory to persist it, and mcp__saltmdb__log_event for any issue/fix worth a short-term event log entry. Identity comes from the hook agent's SALTMDB_AGENT_ID configuration. Do not report back conversationally -- this is a background sweep.",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-stop-critique-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-stop-retrieval-outcome-gate.py",
            "timeout": 15
          },
          {
            "type": "mcp_tool",
            "server": "saltmdb",
            "tool": "capture_trace_complete",
            "input": {
              "harness_turn_id": "${prompt_id}",
              "final_assistant_message": "${last_assistant_message}"
            },
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-stop-related-memories.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/saltmdb-session-end-wrapup-reminder.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
