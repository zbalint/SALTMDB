{
  "hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python $HOME/.mcp/SALTMDB/hooks/saltmdb-session-start-bootstrap.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|run_command",
        "type": "command",
        "command": "python $HOME/.mcp/SALTMDB/hooks/saltmdb-pre-tool-search-gate.py",
        "timeout": 15
      }
    ]
  }
}
